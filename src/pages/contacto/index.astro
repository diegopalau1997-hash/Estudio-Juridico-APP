---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppPicker from '../../components/WhatsAppPicker.astro';
import { SOCIOS, EMAIL_ESTUDIO } from '../../lib/whatsapp';
---

<BaseLayout
  title="Contacto"
  description="Contactate con Estudio Jurídico APP por WhatsApp o email."
  path="/contacto/"
>
  <section class="section">
    <div class="container contacto-grid">
      <div>
        <span class="eyebrow">Contacto</span>
        <h1>¿Necesitás asesoramiento?</h1>
        <p class="lead">
          Contanos brevemente tu situación y coordinamos una consulta. Elegí el tema para que
          tu mensaje llegue directamente al socio que corresponde.
        </p>
        <WhatsAppPicker variant="inline" label="Consultar por WhatsApp" />

        <dl class="datos">
          <div>
            <dt>Ciudad</dt>
            <dd>Buenos Aires, Argentina</dd>
          </div>
          <div>
            <dt>Email general</dt>
            <dd>
              <svg class="icon-inline" aria-hidden="true" viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="4" width="16" height="12" rx="1.5" /><path d="M3 5.5 10 11l7-5.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <a href={`mailto:${EMAIL_ESTUDIO}`}>{EMAIL_ESTUDIO}</a>
            </dd>
          </div>
          <div>
            <dt>WhatsApp / Teléfono</dt>
            <dd>
              <svg class="icon-inline" aria-hidden="true" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" stroke="none"><path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.85.5 3.58 1.38 5.06L2 22l5.12-1.34A9.94 9.94 0 0 0 12.04 22c5.52 0 10-4.48 10-10s-4.48-10-10-10Zm0 18.13c-1.6 0-3.1-.44-4.4-1.2l-.31-.19-3.04.8.81-2.96-.2-.31A8.1 8.1 0 0 1 3.9 12c0-4.5 3.66-8.16 8.14-8.16 4.48 0 8.14 3.66 8.14 8.16s-3.66 8.13-8.14 8.13Z"/></svg>
              {SOCIOS.gisele.numeroVisible}
            </dd>
          </div>
          <div>
            <dt>Gisele Paoletti</dt>
            <dd>
              <svg class="icon-inline" aria-hidden="true" viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="4" width="16" height="12" rx="1.5" /><path d="M3 5.5 10 11l7-5.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <a href={`mailto:${SOCIOS.gisele.email}`}>{SOCIOS.gisele.email}</a>
            </dd>
          </div>
          <div>
            <dt>Diego Palau</dt>
            <dd>
              <svg class="icon-inline" aria-hidden="true" viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="4" width="16" height="12" rx="1.5" /><path d="M3 5.5 10 11l7-5.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <a href={`mailto:${SOCIOS.diego.email}`}>{SOCIOS.diego.email}</a>
            </dd>
          </div>
          <div>
            <dt>Instagram</dt>
            <dd>
              <svg class="icon-inline" aria-hidden="true" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" /></svg>
              <a href="https://www.instagram.com/estudiojapp/" target="_blank" rel="noopener noreferrer">@estudiojapp</a>
            </dd>
          </div>
        </dl>
      </div>

      <aside class="aviso">
        <h2>Aviso</h2>
        <p>
          El envío de una consulta no implica aceptación del caso ni genera relación
          abogado-cliente hasta su confirmación expresa por el estudio.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contacto-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .lead {
    max-width: 55ch;
  }
  .datos {
    margin: 2.5rem 0 0;
    display: grid;
    gap: 1.25rem;
  }
  .datos dt {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-taupe);
    margin-bottom: 0.2rem;
  }
  .datos dd {
    margin: 0;
    font-size: 0.98rem;
  }
  .datos a {
    color: var(--color-navy);
    text-decoration: none;
  }
  .datos a:hover {
    text-decoration: underline;
  }
  .icon-inline {
    display: inline-block;
    vertical-align: -2px;
    margin-right: 0.35rem;
    color: var(--color-taupe);
  }
  .aviso {
    background: var(--color-beige);
    padding: 1.75rem;
    border-radius: 2px;
  }
  .aviso h2 {
    font-size: 1.1rem;
    margin-bottom: 0.6rem;
  }
  .aviso p {
    font-size: 0.88rem;
    margin: 0;
  }
  @media (max-width: 800px) {
    .contacto-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
