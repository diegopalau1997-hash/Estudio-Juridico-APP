---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { TEMAS_WHATSAPP, type TemaWhatsApp } from '../../lib/whatsapp';

export function getStaticPaths() {
  return TEMAS_WHATSAPP.map((tema) => ({
    params: { slug: tema.slug },
    props: { tema },
  }));
}

interface Props {
  tema: TemaWhatsApp;
}
const { tema } = Astro.props as Props;
---

<BaseLayout title={tema.etiqueta} description={tema.resumenBreve} path={`/${tema.slug}/`}>
  <section class="section area">
    <div class="container">
      <nav class="breadcrumb" aria-label="Miga de pan">
        <a href="/">Inicio</a> <span aria-hidden="true">/</span> <span aria-current="page">{tema.etiqueta}</span>
      </nav>
      <span class="eyebrow">Área de práctica</span>
      <h1>{tema.etiqueta}</h1>
      <p class="area__resumen">{tema.resumenBreve}</p>

      <div class="area__cta">
        <WhatsAppButton
          responsable={tema.responsable}
          mensaje={tema.mensaje}
          label={`Consultar por ${tema.etiqueta.toLowerCase()}`}
        />
      </div>

      <p class="area__nota">
        Estamos completando el contenido detallado de esta área (situaciones frecuentes,
        documentación inicial y preguntas frecuentes). Mientras tanto, contanos tu situación
        por WhatsApp y te decimos cómo podemos ayudarte.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .area {
    min-height: 50vh;
  }
  .breadcrumb {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-navy);
  }
  .area__resumen {
    font-size: 1.1rem;
    max-width: 60ch;
    margin-bottom: 2rem;
  }
  .area__cta {
    margin-bottom: 2.5rem;
  }
  .area__nota {
    max-width: 55ch;
    font-size: 0.88rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.5rem;
  }
</style>
