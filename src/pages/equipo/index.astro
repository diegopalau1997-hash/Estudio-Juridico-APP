---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { SOCIOS, mensajePersona } from '../../lib/whatsapp';
import giselePhoto from '../../assets/equipo/gisele-paoletti.png';
import diegoPhoto from '../../assets/equipo/diego-palau.jpeg';
---

<BaseLayout
  title="Equipo"
  description="Gisele Paoletti y Diego Palau, socios de Estudio Jurídico APP."
  path="/equipo/"
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Equipo</span>
      <h1>Paoletti &amp; Palau.</h1>
      <p class="lead">
        Estudio Jurídico APP está integrado por sus dos socios, que trabajan en conjunto en
        cada asunto que llega al estudio.
      </p>

      <div class="equipo-grid">
        <article class="equipo-card">
          <Image src={giselePhoto} alt={SOCIOS.gisele.nombre} class="equipo-card__foto" width={320} height={400} />
          <h2>{SOCIOS.gisele.nombre}</h2>
          <p class="equipo-card__rol">
            {SOCIOS.gisele.rol}
            {SOCIOS.gisele.matricula && <span class="equipo-card__matricula"> · {SOCIOS.gisele.matricula}</span>}
          </p>
          <ul class="equipo-card__formacion">
            {SOCIOS.gisele.formacion.map((f) => <li>{f}</li>)}
          </ul>
          {SOCIOS.gisele.bio.map((p) => <p class="equipo-card__bio">{p}</p>)}
          <ul class="equipo-card__contacto">
            <li><a href={`mailto:${SOCIOS.gisele.email}`}>{SOCIOS.gisele.email}</a></li>
            <li>{SOCIOS.gisele.numeroVisible}</li>
          </ul>
          <WhatsAppButton
            responsable="gisele"
            mensaje={mensajePersona('gisele')}
            label="Escribir a Gisele"
          />
        </article>

        <article class="equipo-card">
          <Image src={diegoPhoto} alt={SOCIOS.diego.nombre} class="equipo-card__foto" width={320} height={400} />
          <h2>{SOCIOS.diego.nombre}</h2>
          <p class="equipo-card__rol">
            {SOCIOS.diego.rol}
            {SOCIOS.diego.matricula && <span class="equipo-card__matricula"> · {SOCIOS.diego.matricula}</span>}
          </p>
          <ul class="equipo-card__formacion">
            {SOCIOS.diego.formacion.map((f) => <li>{f}</li>)}
          </ul>
          {SOCIOS.diego.bio.map((p) => <p class="equipo-card__bio">{p}</p>)}
          <ul class="equipo-card__contacto">
            <li><a href={`mailto:${SOCIOS.diego.email}`}>{SOCIOS.diego.email}</a></li>
            <li>{SOCIOS.diego.numeroVisible}</li>
          </ul>
          <WhatsAppButton
            responsable="diego"
            mensaje={mensajePersona('diego')}
            label="Escribir a Diego"
          />
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    max-width: 60ch;
    margin-bottom: 2.5rem;
  }
  .equipo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  .equipo-card {
    border: 1px solid var(--border-subtle);
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }
  .equipo-card__foto {
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 0.75rem;
  }
  .equipo-card h2 {
    margin-bottom: 0.1rem;
  }
  .equipo-card__rol {
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
  }
  .equipo-card__matricula {
    color: var(--color-taupe);
  }
  .equipo-card__formacion {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    font-size: 0.88rem;
    color: var(--text-body);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .equipo-card__bio {
    font-size: 0.92rem;
  }
  .equipo-card__contacto {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 1.5rem;
    font-size: 0.92rem;
  }
  .equipo-card__contacto a {
    text-decoration: none;
    color: var(--color-navy);
  }
  .equipo-card__contacto a:hover {
    text-decoration: underline;
  }
  @media (max-width: 700px) {
    .equipo-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
