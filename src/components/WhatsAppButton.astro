---
import { waLink, type Responsable } from '../lib/whatsapp';

interface Props {
  responsable: Responsable;
  mensaje: string;
  label?: string;
  variant?: 'solid' | 'outline-dark' | 'outline-light';
}
const { responsable, mensaje, label = 'Consultar por WhatsApp', variant = 'solid' } = Astro.props;
const cls =
  variant === 'solid'
    ? 'btn btn--whatsapp'
    : variant === 'outline-dark'
      ? 'btn btn--outline-dark'
      : 'btn btn--outline-light';
---

<a class={cls} href={waLink(responsable, mensaje)} target="_blank" rel="noopener noreferrer">
  <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.85.5 3.58 1.38 5.06L2 22l5.12-1.34A9.94 9.94 0 0 0 12.04 22c5.52 0 10-4.48 10-10s-4.48-10-10-10Zm0 18.13c-1.6 0-3.1-.44-4.4-1.2l-.31-.19-3.04.8.81-2.96-.2-.31A8.1 8.1 0 0 1 3.9 12c0-4.5 3.66-8.16 8.14-8.16 4.48 0 8.14 3.66 8.14 8.16s-3.66 8.13-8.14 8.13Zm4.47-6.09c-.24-.12-1.44-.71-1.66-.79-.22-.08-.39-.12-.55.12-.16.24-.63.79-.78.95-.14.16-.29.18-.53.06-1.44-.72-2.38-1.28-3.33-2.9-.25-.44.25-.41.72-1.36.08-.16.04-.3-.04-.42-.08-.12-.55-1.33-.75-1.81-.2-.48-.4-.41-.55-.42-.14-.01-.31-.01-.47-.01-.16 0-.43.06-.65.3-.22.24-.86.84-.86 2.03 0 1.19.87 2.35 1 2.51.12.16 1.67 2.55 4.05 3.47 2 .78 2.4.63 2.83.59.43-.04 1.4-.57 1.6-1.12.2-.55.2-1.02.14-1.12-.06-.1-.24-.16-.5-.28Z"/></svg>
  <span>{label}</span>
</a>
