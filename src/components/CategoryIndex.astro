---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TEMAS_WHATSAPP } from '../lib/whatsapp';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  description: string;
  path: string;
  temaSlugs: string[];
  nota?: string;
  /** Frase corta para destacar en grande debajo del intro (p. ej. una credencial fuerte). */
  destacado?: string;
}
const { eyebrow, title, intro, description, path, temaSlugs, nota, destacado } = Astro.props;
const temas = temaSlugs.map((slug) => TEMAS_WHATSAPP.find((t) => t.slug === slug)!).filter(Boolean);
---

<BaseLayout title={title} description={description} path={path}>
  <section class="section">
    <div class="container">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p class="lead">{intro}</p>

      {destacado && (
        <p class="cat-destacado">
          <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
            <path d="M10 1.2 12.2 3l2.8-.4.6 2.8 2.4 1.5-1.2 2.6 1.2 2.6-2.4 1.5-.6 2.8-2.8-.4L10 18.8 7.8 17l-2.8.4-.6-2.8-2.4-1.5 1.2-2.6-1.2-2.6 2.4-1.5.6-2.8L7.8 3 10 1.2Z" />
            <path d="M7.3 10.2 9.2 12l3.8-4" fill="none" stroke="var(--color-cream)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>{destacado}</span>
        </p>
      )}

      <div class="cat-grid">
        {temas.map((tema) => (
          <a class="cat-card" href={`/${tema.slug}/`}>
            <span class="cat-card__title">{tema.etiqueta}</span>
            <p class="cat-card__resumen">{tema.resumenBreve}</p>
            <span class="cat-card__cta">Ver más →</span>
          </a>
        ))}
      </div>

      {nota && <p class="cat-nota">{nota}</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    max-width: 65ch;
    margin-bottom: 1.5rem;
  }
  .cat-destacado {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-navy);
    background: var(--color-beige);
    border: 1px solid var(--color-gold);
    border-radius: 999px;
    padding: 0.5rem 1.05rem 0.5rem 0.85rem;
    margin: 0 0 2.5rem;
  }
  .cat-destacado svg {
    color: var(--color-gold);
    flex-shrink: 0;
  }
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }
  .cat-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    background: var(--bg-surface);
  }
  .cat-card:hover {
    background: var(--color-cream);
  }
  .cat-card__title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--color-navy);
  }
  .cat-card__resumen {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
    flex-grow: 1;
  }
  .cat-card__cta {
    font-size: 0.8rem;
    color: var(--color-taupe);
  }
  .cat-nota {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.85rem;
    color: var(--text-muted);
    max-width: 60ch;
  }
</style>
